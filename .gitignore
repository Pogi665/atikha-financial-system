node_modules/
vendor/
!assets/vendor/
!assets/vendor/**

# Local migration exports, verification manifests and restored upload copies.
.migration-private/*
!.migration-private/.htaccess

# Local secrets (Gemini API key, overrides). Copy config.example.php instead.
config.php

# Uploaded receipt images. The tracked .htaccess / .gitignore stubs are kept.
uploads/receipts/*
!uploads/receipts/.gitignore

uploads/board/*
!uploads/board/.gitignore

# Generated Python caches. Existing tracked caches are not removed by these rules.
__pycache__/
*.pyc

# Future disposable output; preserve the selected permanent visual evidence collection.
/output/*
!/output/system-visual-review/
!/output/system-visual-review/**
