+        output+='diff --git a/'+n+' b/'+n+'\nnew file mode 100644\nindex '+'0'*40+'..'+blob+'\n'+''.join(difflib.unified_diff([],text.splitlines(keepends=True),fromfile='/dev/null',tofile='b/'+n))
