    startNode --> loginFlow --> authenticated
    authenticated -->|"No"| loginError --> loginFlow
    authenticated -->|"Yes"| dashboard --> chooseTask
    chooseTask -->|"Daily entry"| ordinary --> entry
    chooseTask -->|"Scan receipt"| receiptScan -->|"General Journal draft"| entry
    chooseTask -->|"Cash advance"| advances --> entry
    chooseTask -->|"Correction"| corrections --> entry
    chooseTask -->|"View or export"| inspection --> showResult
    chooseTask -->|"Plan or review"| controls --> controlAction
    chooseTask -->|"Other permitted work"| otherTasks --> controlAction
    entry --> draftOrReview
    draftOrReview -->|"Save draft"| saveDraft --> showResult
    draftOrReview -->|"Review"| validate
    validate -->|"No"| errors --> entry
    validate -->|"Yes"| review --> confirmRecord
    confirmRecord -->|"Edit"| entry
    confirmRecord -->|"Yes"| record --> recorded
    recorded -->|"Confirmed recorded"| alertCondition
    recorded -->|"Rejected"| errors
    recorded -->|"Uncertain"| recover --> recorded
    controlAction --> alertCondition
    alertCondition -->|"Yes"| notify --> showResult
    alertCondition -->|"No"| showResult
    showResult --> anotherTask
    anotherTask -->|"Yes"| chooseTask
    anotherTask -->|"No"| logout --> finishNode
